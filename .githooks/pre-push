#!/bin/sh
# Impide empujar directamente a la rama por defecto del remoto.
# Los cambios llegan a main solo por pull request fusionado en GitHub.
#
# Salida de emergencia:
#   ALLOW_MAIN_PUSH=1 git push ...

PROTECTED_REF="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = "$PROTECTED_REF" ] || continue
	[ "$ALLOW_MAIN_PUSH" = "1" ] && continue

	if [ "$local_sha" = "$ZERO" ]; then
		reason="borrar main en el remoto"
	else
		reason="empujar a main directamente"
	fi

	cat >&2 <<EOF

  ✖ Push bloqueado: intentas $reason.

    main avanza únicamente por pull request fusionado en GitHub.
    Empuja tu rama de trabajo y abre el PR:

      git push -u origin \$(git symbolic-ref --short HEAD)
      gh pr create

    Si este push es realmente excepcional:

      ALLOW_MAIN_PUSH=1 git push ...

EOF
	exit 1
done

exit 0
