#!/bin/sh
# Impide commitear directamente en la rama por defecto.
# Constitución, sección Repositorio: "No se hace commit directo a la rama por defecto."
#
# Salida de emergencia (solo para arranque o rescate):
#   ALLOW_MAIN_COMMIT=1 git commit ...

PROTECTED="main"
branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "$PROTECTED" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
	cat >&2 <<'EOF'

  ✖ Commit bloqueado: estás en la rama main.

    La constitución exige trabajar en una rama por funcionalidad.
    Crea la rama y vuelve a commitear:

      git checkout -b 001-nombre-corto
      git commit ...

    Si este commit es realmente excepcional:

      ALLOW_MAIN_COMMIT=1 git commit ...

EOF
	exit 1
fi

exit 0
